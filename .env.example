# ==============================================================================
# Production Environment Variables Blueprint
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Server-side admin operations only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database Connection String (From Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Vite Frontend Supabase URL (Alternative for client-side Vite apps)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Vite Frontend Supabase Anon Key (Alternative for client-side Vite apps)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key for AI features (From Google AI Studio Dashboard)
GEMINI_API_KEY=your-gemini-api-key

# Application Base Domain URL
APP_URL=https://your-app-domain.com
